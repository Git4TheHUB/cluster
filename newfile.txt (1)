/* --------------------------------------------------------- 
   TEXT AND RESPONSE HELPERS 
   --------------------------------------------------------- */

void lower_text(char *s) {
    int i;
    for (i = 0; s[i]; i++) {
        if (s[i] >= 'A' && s[i] <= 'Z') {
            s[i] = (char)(s[i] - 'A' + 'a');
        }
    }
}

bool has(const char *text, const char *word) {
    return strstr(text, word) != NULL;
}

void set_response(const char *text) {
    strncpy(current_response, text, RESPONSE_SIZE - 1);
    current_response[RESPONSE_SIZE - 1] = '\0';
    scroll_line = 0;
    response_line_count = 0;
}

void append_response(const char *text) {
    size_t used = strlen(current_response);
    size_t available = RESPONSE_SIZE - used - 1;
    if (available > 0) {
        strncat(current_response, text, available);
    }
}

void set_suggestion(const char *suggestion) {
    strncpy(next_suggestion, suggestion, sizeof(next_suggestion) - 1);
    next_suggestion[sizeof(next_suggestion) - 1] = '\0';
}

void set_recommendation(const char *word) {
    strncpy(word_recommendation, word, sizeof(word_recommendation) - 1);
    word_recommendation[sizeof(word_recommendation) - 1] = '\0';
}


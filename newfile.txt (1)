/* --------------------------------------------------------- 
   MAIN QUERY PROCESSOR 
   --------------------------------------------------------- */

void evaluate_query(void) {
    double a, b, result;
    char op;
    lower_text(user_input);
    if (strlen(user_input) == 0) {
        return;
    }

    /* Basic arithmetic */
    if (sscanf(user_input, "%lf %c %lf", &a, &op, &b) == 3) {
        bool valid = true;
        switch (op) {
            case '+': result = a + b; break;
            case '-': result = a - b; break;
            case '*': result = a * b; break;
            case '/': 
                if (b == 0) {
                    valid = false;
                    result = 0;
                } else {
                    result = a / b;
                } 
                break;
            default: valid = false; result = 0;
        }
        if (valid) {
            char text[300];
            snprintf(text, sizeof(text), "CALCULATION RESULT\n\n" "%.2f %c %.2f = %.2f\n\n" "Try: ALGEBRA or EXPONENTS", a, op, b, result);
            set_response(text);
            set_suggestion("Try: MATH QUIZ");
        } else {
            set_response(
                "CALCULATION ERROR\n\n"
                "Check the operator and numbers.\n\n"
                "Division by zero is undefined."
            );
        }
        return;
    }

    /* Help */
    if (strcmp(user_input, "help") == 0 || strcmp(user_input, "commands") == 0) {
        set_response(
            "FAIRVIEW AI COMMANDS\n\n"
            "SCHOOL LESSONS:\n"
            "MATH, EXPONENTS, POLYNOMIALS\n"
            "EQUATIONS, FRACTIONS, PROBABILITY\n"
            "SCIENCE, ATOMS, CHEMISTRY\n"
            "ELECTRICITY, BIODIVERSITY, SPACE\n"
            "ENGLISH, LITERARY DEVICES\n"
            "SOCIAL STUDIES, GOVERNMENT, CHARTER\n"
            "WELLNESS, CAREERS, FAIRVIEW\n\n"
            "STUDY TOOLS:\n"
            "MATH QUIZ, SCIENCE QUIZ\n"
            "ENGLISH QUIZ, SOCIAL QUIZ\n"
            "FLASHCARDS, FLIP, STUDY PLAN\n"
            "NEXT, HINT, CHECK\n\n"
            "FUN:\n"
            "TELL ME A JOKE\n"
            "RANDOM FACT\n"
            "ROAST ME\n"
            "MOTIVATE ME\n"
            "WOULD YOU RATHER\n"
            "WHAT IS YOUR DREAM"
        );
        set_suggestion("Try: MATH QUIZ");
        return;
    }

    /* Quizzes */
    if (strcmp(user_input, "math quiz") == 0) {
        start_quiz(SUBJECT_MATH);
        return;
    }
    if (strcmp(user_input, "science quiz") == 0) {
        start_quiz(SUBJECT_SCIENCE);
        return;
    }
    if (strcmp(user_input, "english quiz") == 0) {
        start_quiz(SUBJECT_ENGLISH);
        return;
    }
    if (strcmp(user_input, "social quiz") == 0) {
        start_quiz(SUBJECT_SOCIAL);
        return;
    }
    if (strcmp(user_input, "quiz") == 0) {
        start_quiz(SUBJECT_ALL);
        return;
    }
    if (quiz_active && quiz_waiting && strcmp(user_input, "hint") == 0) {
        set_response(questions[quiz_index].hint);
        set_suggestion("Try A, B, C or D");
        return;
    }
    if (quiz_active && strcmp(user_input, "check") == 0) {
        char text[500];
        const Question *q = &questions[quiz_index];
        const char *options[] = { q->a, q->b, q->c, q->d };
        snprintf(text, sizeof(text), "ANSWER REVIEW\n\n" "Correct answer: %s\n\n" "%s", options[q->answer], q->explanation);
        set_response(text);
        set_suggestion("Type NEXT");
        return;
    }
    if (quiz_active && strcmp(user_input, "next") == 0) {
        quiz_waiting = false;
        quiz_index++;
        show_question();
        return;
    }
    if (quiz_active && quiz_waiting && strlen(user_input) == 1) {
        char c = user_input[0];
        if (c >= 'a' && c <= 'd') {
            submit_answer(c - 'a');
            return;
        }
    }

    /* Flashcards */
    if (strcmp(user_input, "flashcards") == 0 || strcmp(user_input, "flashcard") == 0) {
        start_cards();
        return;
    }
    if (flashcards_active && strcmp(user_input, "flip") == 0) {
        flashcard_answer_visible = !flashcard_answer_visible;
        show_card();
        return;
    }
    if (flashcards_active && strcmp(user_input, "next") == 0) {
        flashcard_index++;
        flashcard_answer_visible = false;
        show_card();
        return;
    }
    if (flashcards_active && strcmp(user_input, "back") == 0) {
        flashcard_index--;
        flashcard_answer_visible = false;
        show_card();
        return;
    }

    /* Study plan */
    if (strcmp(user_input, "study plan") == 0) {
        show_study_day(1);
        return;
    }
    if (strcmp(user_input, "next day") == 0) {
        study_day++;
        if (study_day > 7) {
            study_day = 1;
        }
        show_study_day(study_day);
        return;
    }
    if (strncmp(user_input, "day ", 4) == 0) {
        int day = atoi(user_input + 4);
        if (day >= 1 && day <= 7) {
            show_study_day(day);
        } else {
            set_response("Choose a day from 1 to 7.");
        }
        return;
    }

    /* Lessons */
    int i;
    for (i = 0; i < (int)LESSON_COUNT; i++) {
        if (has(user_input, lessons[i].keywords)) {
            set_response(lessons[i].lesson);
            set_suggestion(lessons[i].suggestion);
            set_recommendation(lessons[i].name);
            return;
        }
    }

    /* Fun AI conversations */
    fun_response(user_input);
}

/* --------------------------------------------------------- 
   RESPONSE WRAPPING AND SCROLLING 
   --------------------------------------------------------- */

int make_lines(char lines[MAX_LINES][LINE_SIZE]) {
    int count = 0;
    int pos = 0;
    int col = 0;
    memset(lines, 0, MAX_LINES * LINE_SIZE);
    while (current_response[pos] != '\0' && count < MAX_LINES) {
        char c = current_response[pos++];
        if (c == '\n') {
            lines[count][col] = '\0';
            count++;
            col = 0;
        } else {
            lines[count][col++] = c;
            if (col >= LINE_SIZE - 1) {
                lines[count][col] = '\0';
                count++;
                col = 0;
            }
        }
    }
    if (count < MAX_LINES && col > 0) {
        lines[count][col] = '\0';
        count++;
    }
    if (count == 0) {
        strcpy(lines[0], " ");
        count = 1;
    }
    return count;
}


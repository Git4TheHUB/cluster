/* --------------------------------------------------------- 
   QUIZ ENGINE 
   --------------------------------------------------------- */

int next_question(int start) {
    int i;
    for (i = start; i < (int)QUESTION_COUNT; i++) {
        if (quiz_subject == SUBJECT_ALL || questions[i].subject == quiz_subject) {
            return i;
        }
    }
    return -1;
}

void show_question(void) {
    int q = next_question(quiz_index);
    char text[700];
    if (q < 0) {
        snprintf(text, sizeof(text), "QUIZ COMPLETE!\n\n" "Score: %d / %d\n\n" "Review mistakes and try again.", quiz_score, quiz_total);
        quiz_active = false;
        quiz_waiting = false;
        set_response(text);
        set_suggestion("Try: FLASHCARDS or STUDY PLAN");
        return;
    }
    quiz_index = q;
    snprintf(text, sizeof(text), "QUESTION %d\n\n%s\n\n" "A) %s\n" "B) %s\n" "C) %s\n" "D) %s\n\n" "Type A, B, C or D.\n" "Type HINT for a clue.", quiz_total + 1, questions[q].question, questions[q].a, questions[q].b, questions[q].c, questions[q].d);
    quiz_waiting = true;
    set_response(text);
    set_suggestion("Answer A/B/C/D or HINT");
}

void start_quiz(int subject) {
    quiz_subject = subject;
    quiz_index = 0;
    quiz_score = 0;
    quiz_total = 0;
    quiz_active = true;
    quiz_waiting = false;
    flashcards_active = false;
    show_question();
}

void submit_answer(int answer) {
    char text[800];
    if (!quiz_active || !quiz_waiting) {
        set_response("No question is waiting for an answer.");
        return;
    }
    const Question *q = &questions[quiz_index];
    const char *options[] = { q->a, q->b, q->c, q->d };
    quiz_total++;
    if (answer == q->answer) {
        quiz_score++;
        snprintf(text, sizeof(text), "CORRECT! NICE WORK!\n\n" "%s\n\n" "Explanation:\n%s\n\n" "Score: %d / %d", q->question, q->explanation, quiz_score, quiz_total);
    } else {
        snprintf(text, sizeof(text), "NOT QUITE! KEEP GOING!\n\n" "%s\n\n" "Correct answer: %s\n\n" "%s\n\n" "Score: %d / %d", q->question, options[q->answer], q->explanation, quiz_score, quiz_total);
    }
    quiz_waiting = false;
    set_response(text);
    set_suggestion("Type NEXT for another question");
}

